# =============================================================================
# .env.security — Security-hardened environment overrides
# =============================================================================
# USAGE: Load AFTER the main .env file:
#   docker compose --env-file .env --env-file .env.security \
#     -f compose.yaml -f compose.full.yaml -f compose.observability.yaml \
#     -f compose.security.yaml up
#
# !! CHANGE ALL PLACEHOLDER VALUES BEFORE DEPLOYING TO ANY SHARED ENVIRONMENT !!
# Generate a strong password:  openssl rand -base64 32
# Generate a hex key:          openssl rand -hex 64
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# ROTATE: Replace ALL three with strong, unique, randomly generated passwords.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_32CHARS
POSTGRES_ASTRONOMY_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_32CHARS
POSTGRES_MONITORING_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_32CHARS

# Force SSL on all postgres client connections (set to 'require' or 'verify-full').
# 'prefer' is the base-compose default; 'require' is enforced here.
POSTGRES_SSLMODE=require

# ── Flagd-UI secret key ───────────────────────────────────────────────────────
# ROTATE: Generate with: openssl rand -hex 64
# In production, prefer Docker Secrets (see compose.security.yaml) over this env var.
SECRET_KEY_BASE=REPLACE_WITH_128_HEX_CHAR_RANDOM_SECRET

# ── Envoy admin interface ─────────────────────────────────────────────────────
# Bind admin port to loopback only — never 0.0.0.0 in production.
ENVOY_ADMIN_ADDR=127.0.0.1

# ── OTel Collector ────────────────────────────────────────────────────────────
# Restrict CORS to known origins in production (replace * with actual frontend URL).
OTEL_COLLECTOR_CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ── Network hardening ─────────────────────────────────────────────────────────
# Bind Envoy listener to all interfaces for external traffic (keep as-is unless
# you place Envoy behind another load-balancer that can handle this).
ENVOY_ADDR=0.0.0.0
